<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Foto Profil -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/profile"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_background"
        android:padding="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Nama Driver -->
    <TextView
        android:id="@+id/tvDriverName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Abdul Driver"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="15sp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/imgProfile"
        app:layout_constraintTop_toTopOf="@id/imgProfile"
        app:layout_constraintEnd_toStartOf="@id/tvChatTime" />

    <!-- Waktu Chat -->
    <TextView
        android:id="@+id/tvChatTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11.58 AM"
        android:textColor="#888888"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/tvDriverName"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pesan Terakhir -->
    <TextView
        android:id="@+id/tvLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Halo"
        android:textColor="#7D7D7D"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/tvDriverName"
        app:layout_constraintTop_toBottomOf="@id/tvDriverName"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
